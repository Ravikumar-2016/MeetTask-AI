# ==========================================
# MeetTask AI - Environment Variables Template
# ==========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# ==========================================

# ==========================================
# VERCEL BLOB STORAGE (Optional - for Vercel deployments)
# ==========================================
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# ==========================================
# ASSEMBLYAI - Speech-to-Text API
# Get your key at: https://www.assemblyai.com/
# ==========================================
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# ==========================================
# FIREBASE CLIENT (Frontend - Vite)
# Get these from Firebase Console > Project Settings > Your Apps
# ==========================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_REGION=your-region

# ==========================================
# FIREBASE ADMIN SDK (Backend - API Routes)
# Get these from Firebase Console > Project Settings > Service Accounts
# ==========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==========================================
# CLOUDINARY - Media Storage
# Get these from Cloudinary Dashboard
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ==========================================
# RESEND - Email Service (Optional)
# Get your key at: https://resend.com/
# ==========================================
RESEND_API_KEY=your_resend_api_key

# ==========================================
# ENVIRONMENT
# ==========================================
NODE_ENV=development

# ==========================================
# OPTIONAL - WEBHOOK SECRET (for production)
# ==========================================
# WEBHOOK_SECRET=your-custom-webhook-secret
